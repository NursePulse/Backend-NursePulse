@startuml NursePulsePlatformClassDiagram

title <b>NursePulse Platform — Class Diagram</b>

hide empty members
hide circle
skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam roundCorner 8
skinparam titleFontSize 20
skinparam nodesep 30
skinparam ranksep 45
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #475569
  FontStyle bold
  StereotypeFontSize 10
}
skinparam package {
  FontStyle bold
  FontSize 14
  BorderColor #64748B
}
skinparam arrow {
  Color #64748B
  FontColor #475569
  FontSize 11
}
skinparam note {
  BackgroundColor #FEFCE8
  BorderColor #CA8A04
}

' ===================== SHARED KERNEL (top tier) =====================
package "Shared Kernel" #E2E8F0 {
  abstract class "AbstractDomainAggregateRoot<T>" as SharedAggregate {
    - domainEvents: List<Object>
    + registerDomainEvent(event: Object): void
  }

  abstract class "AuditableAbstractPersistenceEntity" as AuditableEntity {
    - id: Long
    - createdAt: LocalDateTime
    - updatedAt: LocalDateTime
  }

  class "Result<T>" as Result {
    - value: T
    - error: ApplicationError
    + isSuccess(): boolean
    + isFailure(): boolean
  }

  class ApplicationError <<record>> {
    code: String
    message: String
    details: String
  }

  class ResponseEntityAssembler
  class GlobalExceptionHandler
  class OpenApiConfiguration
  class LocaleConfiguration

  Result o-- ApplicationError
  ResponseEntityAssembler ..> Result
  GlobalExceptionHandler ..> ApplicationError
  OpenApiConfiguration -[hidden]- LocaleConfiguration
}

' ===================== IAM (second tier, left) =====================
package "IAM Bounded Context" #DBEAFE {
  enum Roles {
    ROLE_NURSE
    ROLE_DOCTOR
    ROLE_ADMIN
  }

  class User <<Aggregate Root>> {
    - id: Long
    - username: String
    - password: String
    - roles: Set<Role>
    + addRole(role: Role): User
    + addRoles(roles: List<Role>): User
  }

  class Role <<Entity>> {
    - id: Long
    - name: Roles
    + getStringName(): String
    + getDefaultRole(): Role
    + toRoleFromName(name: String): Role
  }

  class SignUpCommand <<record>> {
    username: String
    password: String
    roles: List<Role>
  }

  class SignInCommand <<record>> {
    username: String
    password: String
  }

  class UpdateUserRolesCommand <<record>> {
    userId: Long
    roles: List<Role>
    requestedBy: String
  }

  interface UserCommandService {
    + handle(command: SignUpCommand): Result<User>
    + handle(command: SignInCommand): Result<User>
  }

  interface UserQueryService
  interface RoleCommandService
  interface RoleQueryService
  class UserCommandServiceImpl
  class UserQueryServiceImpl
  class RoleCommandServiceImpl
  class RoleQueryServiceImpl

  interface UserRepository
  interface RoleRepository
  class UserRepositoryImpl
  class RoleRepositoryImpl
  interface UserPersistenceRepository
  interface RolePersistenceRepository

  class UserPersistenceEntity <<JPA Entity>>
  class RolePersistenceEntity <<JPA Entity>>
  class UserPersistenceAssembler
  class RolePersistenceAssembler

  class AuthenticationController <<REST Controller>> {
    + signUp(resource: SignUpResource): ResponseEntity
    + signIn(resource: SignInResource): ResponseEntity
  }

  class UsersController <<REST Controller>> {
    + getAllUsers(): ResponseEntity
    + getUserById(userId: Long): ResponseEntity
    + updateUserRoles(userId: Long, resource: UpdateUserRolesResource): ResponseEntity
  }

  class RolesController <<REST Controller>> {
    + getAllRoles(): ResponseEntity
  }

  class WebSecurityConfiguration {
    + filterChain(http: HttpSecurity): SecurityFilterChain
    + authenticationProvider(): DaoAuthenticationProvider
  }

  class BearerAuthorizationRequestFilter
  class UserDetailsServiceImpl
  class BCryptHashingService
  class BearerTokenService
  class IamContextFacade
  class ApplicationReadyEventHandler

  ' --- domain ---
  User "1" -- "*" Role
  Role --> Roles
  SignUpCommand -[hidden]- SignInCommand

  ' --- application layer (controllers on top, impls below interfaces) ---
  AuthenticationController --> UserCommandService
  UsersController --> UserQueryService
  RolesController --> RoleQueryService
  AuthenticationController -[hidden]right- UsersController
  UsersController -[hidden]right- RolesController
  UserCommandServiceImpl .up.|> UserCommandService
  UserQueryServiceImpl .up.|> UserQueryService
  RoleCommandServiceImpl .up.|> RoleCommandService
  RoleQueryServiceImpl .up.|> RoleQueryService
  UserCommandServiceImpl ..> SignUpCommand
  UserCommandServiceImpl ..> SignInCommand
  UserCommandServiceImpl ..> UpdateUserRolesCommand
  UsersController --> UserCommandService

  ' --- infrastructure layer ---
  UserCommandServiceImpl --> UserRepository
  UserCommandServiceImpl --> RoleRepository
  UserCommandServiceImpl --> BCryptHashingService
  UserCommandServiceImpl --> BearerTokenService
  UserRepositoryImpl .up.|> UserRepository
  RoleRepositoryImpl .up.|> RoleRepository
  UserRepositoryImpl --> UserPersistenceRepository
  RoleRepositoryImpl --> RolePersistenceRepository
  UserRepositoryImpl --> UserPersistenceAssembler
  RoleRepositoryImpl --> RolePersistenceAssembler
  UserPersistenceAssembler ..> UserPersistenceEntity
  RolePersistenceAssembler ..> RolePersistenceEntity
  UserPersistenceEntity "*" -- "*" RolePersistenceEntity

  ' --- security ---
  WebSecurityConfiguration --> BearerAuthorizationRequestFilter
  WebSecurityConfiguration --> BCryptHashingService
  BearerAuthorizationRequestFilter --> BearerTokenService
  BearerAuthorizationRequestFilter --> UserDetailsServiceImpl
  IamContextFacade --> UserQueryService
  ApplicationReadyEventHandler --> RoleCommandService
}

note bottom of WebSecurityConfiguration
  <b>Authorizes every REST controller</b>
  Public: authentication, Swagger / OpenAPI
  NURSE: patients, vital signs,
    handovers, alert attendance
  DOCTOR: clinical read access,
    alert closure, audit read
  ADMIN: all API capabilities
end note

' ===================== PATIENTS (second tier, right) =====================
package "Patients Bounded Context" #DCFCE7 {
  enum PatientStatus

  class Patient <<Aggregate Root>> {
    - id: Long
    - firstName: String
    - lastName: String
    - documentNumber: String
    - birthDate: LocalDate
    - gender: String
    - diagnosis: String
    - roomNumber: String
    - bedNumber: String
    - attendingPhysician: String
    - status: PatientStatus
    - admissionDate: LocalDate
    + update(command: UpdatePatientCommand): void
    + getFullName(): String
  }

  class CreatePatientCommand <<record>>
  class UpdatePatientCommand <<record>>
  class DeletePatientCommand <<record>>
  class GetPatientByIdQuery <<record>>
  class GetAllPatientsQuery <<record>>

  interface PatientCommandService
  interface PatientQueryService
  class PatientCommandServiceImpl
  class PatientQueryServiceImpl
  interface PatientRepository
  class PatientRepositoryImpl
  interface PatientPersistenceRepository
  class PatientPersistenceEntity <<JPA Entity>>
  class PatientPersistenceAssembler

  class PatientsController <<REST Controller>> {
    + createPatient(resource: CreatePatientResource): ResponseEntity
    + getAllPatients(): ResponseEntity
    + getPatientById(patientId: Long): ResponseEntity
    + updatePatient(patientId: Long, resource: UpdatePatientResource): ResponseEntity
    + deletePatient(patientId: Long): ResponseEntity
  }

  Patient --> PatientStatus
  Patient ..> CreatePatientCommand
  Patient ..> UpdatePatientCommand
  DeletePatientCommand -[hidden]- GetPatientByIdQuery
  GetPatientByIdQuery -[hidden]- GetAllPatientsQuery
  PatientsController --> PatientCommandService
  PatientsController --> PatientQueryService
  PatientCommandServiceImpl .up.|> PatientCommandService
  PatientQueryServiceImpl .up.|> PatientQueryService
  PatientCommandServiceImpl --> PatientRepository
  PatientQueryServiceImpl --> PatientRepository
  PatientRepositoryImpl .up.|> PatientRepository
  PatientRepositoryImpl --> PatientPersistenceRepository
  PatientRepositoryImpl --> PatientPersistenceAssembler
  PatientPersistenceAssembler .up.> Patient
  PatientPersistenceAssembler ..> PatientPersistenceEntity
}

' ===================== VITAL SIGNS (third tier) =====================
package "Vital Signs Bounded Context" #FEF3C7 {
  enum RiskLevel

  class BloodPressure <<Value Object>> {
    systolic: Integer
    diastolic: Integer
  }

  class VitalSignRecord <<Aggregate Root>> {
    - id: Long
    - patientId: Long
    - nurseId: Long
    - heartRate: Integer
    - respiratoryRate: Integer
    - bloodPressure: BloodPressure
    - oxygenSaturation: Integer
    - temperature: BigDecimal
    - riskLevel: RiskLevel
    - recordedAt: LocalDateTime
    + assignRiskLevel(riskLevel: RiskLevel): VitalSignRecord
  }

  class CreateVitalSignRecordCommand <<record>>
  class VitalSignRecordedEvent <<record>>
  class GetAllVitalSignRecordsQuery <<record>>
  class GetVitalSignRecordByIdQuery <<record>>
  class GetVitalSignRecordsByPatientIdQuery <<record>>
  class GetLatestVitalSignRecordByPatientIdQuery <<record>>

  interface VitalSignRecordCommandService
  interface VitalSignRecordQueryService
  class VitalSignRecordCommandServiceImpl
  class VitalSignRecordQueryServiceImpl
  interface VitalSignRecordRepository
  class VitalSignRecordRepositoryImpl
  interface VitalSignRecordPersistenceRepository
  class VitalSignRecordPersistenceEntity <<JPA Entity>>
  class BloodPressurePersistenceEmbeddable <<JPA Embeddable>>
  class VitalSignRecordPersistenceAssembler

  class VitalSignRecordsController <<REST Controller>> {
    + createVitalSignRecord(resource: CreateVitalSignRecordResource): ResponseEntity
    + getAllVitalSignRecords(): ResponseEntity
    + getVitalSignRecordsByPatientId(patientId: Long): ResponseEntity
    + getLatestVitalSignRecordByPatientId(patientId: Long): ResponseEntity
    + getVitalSignRecordById(recordId: Long): ResponseEntity
  }

  VitalSignRecord *-- BloodPressure
  VitalSignRecord --> RiskLevel
  VitalSignRecord ..> VitalSignRecordedEvent : emits
  CreateVitalSignRecordCommand -[hidden]- GetAllVitalSignRecordsQuery
  GetAllVitalSignRecordsQuery -[hidden]- GetVitalSignRecordByIdQuery
  GetVitalSignRecordsByPatientIdQuery -[hidden]- GetLatestVitalSignRecordByPatientIdQuery
  VitalSignRecordsController --> VitalSignRecordCommandService
  VitalSignRecordsController --> VitalSignRecordQueryService
  VitalSignRecordCommandServiceImpl .up.|> VitalSignRecordCommandService
  VitalSignRecordQueryServiceImpl .up.|> VitalSignRecordQueryService
  VitalSignRecordCommandServiceImpl --> VitalSignRecordRepository
  VitalSignRecordQueryServiceImpl --> VitalSignRecordRepository
  VitalSignRecordRepositoryImpl .up.|> VitalSignRecordRepository
  VitalSignRecordRepositoryImpl --> VitalSignRecordPersistenceRepository
  VitalSignRecordRepositoryImpl --> VitalSignRecordPersistenceAssembler
  VitalSignRecordPersistenceAssembler -[hidden]- VitalSignRecordPersistenceEntity
  VitalSignRecordPersistenceEntity *-- BloodPressurePersistenceEmbeddable
}

' ===================== HANDOVER (third tier) =====================
package "Handover Bounded Context" #FCE7F3 {
  enum HandoverStatus {
    PENDING
    ACKNOWLEDGED
  }

  class Handover <<Aggregate Root>> {
    - id: Long
    - patientId: Long
    - title: String
    - description: String
    - status: HandoverStatus
    - incomingNurseId: Long
    - additionalNotes: String
    + updateInformation(title: String, description: String): Handover
    + acknowledge(incomingNurseId: Long, notes: String): void
  }

  class CreateHandoverCommand <<record>>
  class AcknowledgeHandoverCommand <<record>>
  class GetAllHandoversQuery <<record>>
  class GetAllHandoversByPatientIdQuery <<record>>
  class GetHandoverByIdQuery <<record>>

  interface HandoverCommandService
  interface HandoverQueryService
  class HandoverCommandServicesImpl
  class HandoverQueryServiceImpl
  interface HandoverRepository
  class HandoverRepositoryImpl
  interface HandoverPersistenceRepository
  class HandoverPersistenceEntity <<JPA Entity>>
  class HandoverPersistenceAssembler

  class HandoversController <<REST Controller>> {
    + createHandover(resource: CreateHandoverResource): ResponseEntity
    + getHandoversByPatientId(patientId: Long, startDate: Date, endDate: Date): ResponseEntity
    + getHandoverById(handoverId: Long): ResponseEntity
    + acknowledgeHandover(handoverId: Long, resource: AcknowledgeHandoverResource): ResponseEntity
  }

  Handover --> HandoverStatus
  CreateHandoverCommand -[hidden]- AcknowledgeHandoverCommand
  GetAllHandoversQuery -[hidden]- GetAllHandoversByPatientIdQuery
  GetAllHandoversByPatientIdQuery -[hidden]- GetHandoverByIdQuery
  HandoversController --> HandoverCommandService
  HandoversController --> HandoverQueryService
  HandoverCommandServicesImpl .up.|> HandoverCommandService
  HandoverQueryServiceImpl .up.|> HandoverQueryService
  HandoverCommandServicesImpl --> HandoverRepository
  HandoverQueryServiceImpl --> HandoverRepository
  HandoverRepositoryImpl .up.|> HandoverRepository
  HandoverRepositoryImpl --> HandoverPersistenceRepository
  HandoverRepositoryImpl --> HandoverPersistenceAssembler
  HandoverPersistenceAssembler -[hidden]- HandoverPersistenceEntity
}

' ===================== CRITICAL EVENTS (third tier) =====================
package "Critical Events Bounded Context" #FEE2E2 {
  enum AlertType
  enum AlertSeverity

  enum AlertStatus {
    OPEN
    ATTENDED
    CLOSED
  }

  class Alert <<Aggregate Root>> {
    - id: Long
    - patientId: Long
    - type: AlertType
    - severity: AlertSeverity
    - description: String
    - status: AlertStatus
    - triggeredBy: String
    - attendedBy: String
    - attendedAt: LocalDateTime
    - closedBy: String
    - resolutionNotes: String
    - closedAt: LocalDateTime
    + attend(command: AttendAlertCommand): void
    + close(command: CloseAlertCommand): void
  }

  class CreateAlertCommand <<record>>
  class AttendAlertCommand <<record>>
  class CloseAlertCommand <<record>>
  class GetAllAlertsQuery <<record>>
  class GetAlertsByPatientIdQuery <<record>>
  class GetAlertByIdQuery <<record>>

  interface AlertCommandService
  interface AlertQueryService
  class AlertCommandServiceImpl
  class AlertQueryServiceImpl
  interface AlertRepository
  class AlertRepositoryImpl
  interface AlertPersistenceRepository
  class AlertPersistenceEntity <<JPA Entity>>
  class AlertPersistenceAssembler

  class AlertsController <<REST Controller>> {
    + createAlert(resource: CreateAlertResource): ResponseEntity
    + getAllAlerts(): ResponseEntity
    + getAlertsByPatientId(patientId: Long): ResponseEntity
    + getAlertById(alertId: Long): ResponseEntity
    + attendAlert(alertId: Long, resource: AttendAlertResource): ResponseEntity
    + closeAlert(alertId: Long, resource: CloseAlertResource): ResponseEntity
  }

  Alert --> AlertType
  Alert --> AlertSeverity
  Alert --> AlertStatus
  Alert ..> AttendAlertCommand
  Alert ..> CloseAlertCommand
  CreateAlertCommand -[hidden]- GetAllAlertsQuery
  GetAlertsByPatientIdQuery -[hidden]- GetAlertByIdQuery
  AlertsController --> AlertCommandService
  AlertsController --> AlertQueryService
  AlertCommandServiceImpl .up.|> AlertCommandService
  AlertQueryServiceImpl .up.|> AlertQueryService
  AlertCommandServiceImpl --> AlertRepository
  AlertQueryServiceImpl --> AlertRepository
  AlertRepositoryImpl .up.|> AlertRepository
  AlertRepositoryImpl --> AlertPersistenceRepository
  AlertRepositoryImpl --> AlertPersistenceAssembler
  AlertPersistenceAssembler -[hidden]- AlertPersistenceEntity
}

' ===================== AUDIT LOGS (third tier) =====================
package "Audit Logs Bounded Context" #EDE9FE {
  enum AuditedEntityType
  enum AuditActionType

  class AuditMetadata <<Value Object>> {
    metadataJson: String
  }

  class AuditLog <<Aggregate Root / JPA Entity>> {
    - patientId: Long
    - entityType: AuditedEntityType
    - entityId: String
    - actionType: AuditActionType
    - performedBy: String
    - performedAt: Instant
    - metadata: AuditMetadata
    + create(command: CreateAuditLogCommand): AuditLog
  }

  class CreateAuditLogCommand <<record>>
  class GetAuditLogsQuery <<record>>
  class GetAuditLogByIdQuery <<record>>
  class GetPatientAuditTimelineQuery <<record>>
  class GetEntityAuditHistoryQuery <<record>>

  interface AuditLogCommandService
  interface AuditLogQueryService
  class AuditLogCommandServiceImpl
  class AuditLogQueryServiceImpl
  interface AuditLogRepository
  class AuditLogSpecificationAssembler

  class AuditLogsController <<REST Controller>> {
    + createAuditLog(resource: CreateAuditLogResource): ResponseEntity
    + getAuditLogs(filters, page, size): ResponseEntity
    + getAuditLogById(auditLogId: Long): ResponseEntity
    + getPatientAuditTimeline(patientId: Long, from: Instant, to: Instant): ResponseEntity
    + getEntityAuditHistory(entityType: AuditedEntityType, entityId: String): ResponseEntity
  }

  AuditLog *-- AuditMetadata
  AuditLog --> AuditedEntityType
  AuditLog --> AuditActionType
  AuditLog ..> CreateAuditLogCommand
  GetAuditLogsQuery -[hidden]- GetAuditLogByIdQuery
  GetPatientAuditTimelineQuery -[hidden]- GetEntityAuditHistoryQuery
  AuditLogsController --> AuditLogCommandService
  AuditLogsController --> AuditLogQueryService
  AuditLogCommandServiceImpl .up.|> AuditLogCommandService
  AuditLogQueryServiceImpl .up.|> AuditLogQueryService
  AuditLogCommandServiceImpl --> AuditLogRepository
  AuditLogQueryServiceImpl --> AuditLogRepository
  AuditLogRepository ..> AuditLogSpecificationAssembler
}

note bottom of AuditLog
  Append-only clinical traceability.
  No update or delete operation is exposed.
end note

' ===================== CLINICAL EVENTS =====================
package "Clinical Events Bounded Context" #FFEDD5 {
  enum ClinicalEventType
  enum ClinicalEventSeverity

  class ClinicalEvent <<Aggregate Root>> {
    - id: Long
    - patientId: Long
    - eventType: ClinicalEventType
    - severity: ClinicalEventSeverity
    - title: String
    - description: String
    - registeredBy: String
    - occurredAt: LocalDateTime
  }

  class CreateClinicalEventCommand <<record>>
  class GetAllClinicalEventsQuery <<record>>
  class GetClinicalEventsByPatientIdQuery <<record>>

  interface ClinicalEventCommandService
  interface ClinicalEventQueryService
  class ClinicalEventCommandServiceImpl
  class ClinicalEventQueryServiceImpl
  interface ClinicalEventRepository
  class ClinicalEventRepositoryImpl
  interface ClinicalEventPersistenceRepository
  class ClinicalEventPersistenceEntity <<JPA Entity>>
  class ClinicalEventPersistenceAssembler

  class ClinicalEventsController <<REST Controller>> {
    + createClinicalEvent(resource: CreateClinicalEventResource): ResponseEntity
    + getAllClinicalEvents(): ResponseEntity
    + getClinicalEventsByPatientId(patientId: Long): ResponseEntity
  }

  ClinicalEvent --> ClinicalEventType
  ClinicalEvent --> ClinicalEventSeverity
  ClinicalEvent ..> CreateClinicalEventCommand
  GetAllClinicalEventsQuery -[hidden]- GetClinicalEventsByPatientIdQuery
  ClinicalEventsController --> ClinicalEventCommandService
  ClinicalEventsController --> ClinicalEventQueryService
  ClinicalEventCommandServiceImpl .up.|> ClinicalEventCommandService
  ClinicalEventQueryServiceImpl .up.|> ClinicalEventQueryService
  ClinicalEventCommandServiceImpl --> ClinicalEventRepository
  ClinicalEventQueryServiceImpl --> ClinicalEventRepository
  ClinicalEventRepositoryImpl .up.|> ClinicalEventRepository
  ClinicalEventRepositoryImpl --> ClinicalEventPersistenceRepository
  ClinicalEventRepositoryImpl --> ClinicalEventPersistenceAssembler
  ClinicalEventPersistenceAssembler -[hidden]- ClinicalEventPersistenceEntity
}

' ===================== SHARED KERNEL INHERITANCE =====================
User -up-|> SharedAggregate
Patient -up-|> SharedAggregate
VitalSignRecord -up-|> SharedAggregate
Handover -up-|> SharedAggregate
Alert -up-|> SharedAggregate
AuditLog -up-|> AuditableEntity

' ===================== PACKAGE GRID (hidden layout links) =====================
' Row 1: Shared Kernel + IAM / Row 2: Patients + Vital Signs
' Row 3: Handover + Critical Events / Row 4: Audit Logs
ApplicationError -[hidden]down- PatientsController
RolePersistenceEntity -[hidden]down- VitalSignRecordsController
PatientPersistenceEntity -[hidden]down- HandoversController
BloodPressurePersistenceEmbeddable -[hidden]down- AlertsController
HandoverPersistenceEntity -[hidden]down- AuditLogsController

' ===================== CROSS-CONTEXT REFERENCES =====================
' Logical references are stored as identifiers to preserve
' bounded-context independence.
VitalSignRecord .up.> Patient : patientId
Handover .up.> Patient : patientId
Alert .up.> Patient : patientId
AuditLog .up.> Patient : patientId
VitalSignRecord .up.> User : nurseId
Handover .up.> User : incomingNurseId
Alert .up.> User : username
AuditLog .up.> User : performedBy
ClinicalEvent -up-|> SharedAggregate
ClinicalEvent .up.> Patient : patientId
ClinicalEvent .up.> User : registeredBy

@enduml
